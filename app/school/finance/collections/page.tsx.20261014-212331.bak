import Link from "next/link";
import { requirePermission } from "@/app/lib/auth/authorization";
import { getOrganizationContext } from "@/app/lib/auth/organization-context";
import { createClient } from "@/app/lib/supabase/server";

type Payment = {
  id: string;
  student_fee_account_id: string;
  amount: number | string;
  payment_date: string;
  payment_method: string;
  reference: string;
  received_by_user_id: string;
  status: string;
};

type Account = { id: string; student_id: string };
type Student = { id: string; full_name: string };
type Receiver = { id: string; display_name: string | null };

function money(value: number, locale: string, currency: string) {
  return new Intl.NumberFormat(locale, {
    style: "currency",
    currency,
    maximumFractionDigits: 0,
  }).format(value);
}

function todayInTimezone(timeZone: string) {
  try {
    const parts = new Intl.DateTimeFormat("en-CA", {
      timeZone,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).formatToParts(new Date());
    const part = (type: string) =>
      parts.find((item) => item.type === type)?.value ?? "";
    return `${part("year")}-${part("month")}-${part("day")}`;
  } catch {
    return new Date().toISOString().slice(0, 10);
  }
}
function validDate(value?: string) {
  if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return null;
  const parsed = new Date(`${value}T00:00:00.000Z`);
  return !Number.isNaN(parsed.getTime()) &&
    parsed.toISOString().slice(0, 10) === value
    ? value
    : null;
}

export default async function DailyCollectionsPage({
  searchParams,
}: {
  searchParams: Promise<{ date?: string }>;
}) {
  await requirePermission("school.fees.read");
  const { organizationId } = await getOrganizationContext();
  const supabase = await createClient();
  const { data: tenantSettings } = await supabase
    .from("organization_settings")
    .select("timezone, currency_code, locale")
    .eq("organization_id", organizationId)
    .maybeSingle();

  const configuredCurrency =
    typeof tenantSettings?.currency_code === "string" &&
    /^[A-Z]{3}$/.test(tenantSettings.currency_code)
      ? tenantSettings.currency_code
      : "UGX";
  const configuredLocale =
    typeof tenantSettings?.locale === "string" &&
    tenantSettings.locale.trim()
      ? tenantSettings.locale
      : "en-UG";
  const configuredTimezone =
    typeof tenantSettings?.timezone === "string" &&
    tenantSettings.timezone.trim()
      ? tenantSettings.timezone
      : "Africa/Kampala";
  const params = await searchParams;
  const selectedDate = validDate(params.date) ??
    todayInTimezone(configuredTimezone);

  const { data, error } = await supabase
    .from("school_fee_payments")
    .select("id, student_fee_account_id, amount, payment_date, payment_method, reference, received_by_user_id, status")
    .eq("organization_id", organizationId)
    .eq("payment_date", selectedDate)
    .eq("status", "confirmed")
    .order("payment_date", { ascending: true })
    .order("reference", { ascending: true });

  if (error) throw new Error(error.message);

  const payments = (data ?? []) as Payment[];
  const accountIds = [...new Set(payments.map((p) => p.student_fee_account_id))];
  const receiverIds = [...new Set(payments.map((p) => p.received_by_user_id))];

  const [{ data: accounts, error: accountError }, { data: receivers, error: receiverError }] =
    await Promise.all([
      accountIds.length
        ? supabase.from("school_student_fee_accounts")
            .select("id, student_id")
            .eq("organization_id", organizationId)
            .in("id", accountIds)
        : Promise.resolve({ data: [], error: null }),
      receiverIds.length
        ? supabase.from("user_profiles")
            .select("id, display_name")
            .in("id", receiverIds)
        : Promise.resolve({ data: [], error: null }),
    ]);

  if (accountError) throw new Error(accountError.message);
  if (receiverError) throw new Error(receiverError.message);

  const accountRows = (accounts ?? []) as Account[];
  const accountById = new Map(accountRows.map((a) => [a.id, a]));
  const studentIds = [...new Set(accountRows.map((a) => a.student_id))];

  const { data: students, error: studentError } = studentIds.length
    ? await supabase.from("students")
        .select("id, full_name")
        .eq("organization_id", organizationId)
        .in("id", studentIds)
    : { data: [], error: null };

  if (studentError) throw new Error(studentError.message);

  const studentById = new Map(
    ((students ?? []) as Student[]).map((s) => [s.id, s.full_name]),
  );
  const receiverById = new Map(
    ((receivers ?? []) as Receiver[]).map((r) => [
      r.id,
      r.display_name ?? "Unnamed staff",
    ]),
  );

  const total = payments.reduce((sum, p) => sum + Number(p.amount), 0);
  const methods = new Map<string, number>();
  for (const payment of payments) {
    methods.set(
      payment.payment_method,
      (methods.get(payment.payment_method) ?? 0) + Number(payment.amount),
    );
  }

  return (
    <main className="min-h-screen bg-slate-950 px-6 py-10 text-white">
      <div className="mx-auto max-w-7xl space-y-8">
        <header>
          <Link href="/school/finance/payments" className="text-sm text-slate-400 hover:text-white">
            â† Payment Ledger
          </Link>
          <p className="mt-4 text-sm uppercase tracking-[0.2em] text-slate-500">
            School Finance
          </p>
          <h1 className="mt-2 text-3xl font-semibold">Daily Collections</h1>
          <p className="mt-2 text-sm text-slate-400">
            Confirmed payments received on the selected date. Pending, cancelled, and reversed payments are excluded.
          </p>
        </header>

        <form method="get" className="flex flex-wrap items-end gap-3 rounded-xl border border-slate-800 bg-slate-900 p-5">
          <div>
            <label htmlFor="date" className="mb-2 block text-sm text-slate-300">Collection date</label>
            <input
              id="date"
              name="date"
              type="date"
              required
              defaultValue={selectedDate}
              className="rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-white"
            />
          </div>
          <button type="submit" className="rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-950">
            View report
          </button>
          <Link
            href={`/school/finance/collections/export?date=${selectedDate}`}
            className="rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200"
          >
            Export CSV
          </Link>
          <Link
            href={`/school/finance/collections/pdf?date=${selectedDate}`}
            target="_blank"
            rel="noopener noreferrer"
            className="rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200"
          >
            Download PDF
          </Link>
        </form>

        <section className="grid gap-4 sm:grid-cols-2">
          <div className="rounded-xl border border-slate-800 bg-slate-900 p-5">
            <p className="text-sm text-slate-400">Confirmed collections</p>
            <p className="mt-2 text-3xl font-semibold">{money(total, configuredLocale, configuredCurrency)}</p>
            <p className="mt-2 text-xs text-slate-500">{selectedDate}</p>
          </div>
          <div className="rounded-xl border border-slate-800 bg-slate-900 p-5">
            <p className="text-sm text-slate-400">Confirmed transactions</p>
            <p className="mt-2 text-3xl font-semibold">{payments.length}</p>
            <p className="mt-2 text-xs text-slate-500">Confirmed payments only</p>
          </div>
        </section>

        <section className="rounded-xl border border-slate-800 bg-slate-900">
          <div className="border-b border-slate-800 px-5 py-4">
            <h2 className="font-semibold">Collections by payment method</h2>
          </div>
          {methods.size === 0 ? (
            <p className="px-5 py-6 text-sm text-slate-400">No confirmed collections for this date.</p>
          ) : (
            <div className="divide-y divide-slate-800">
              {[...methods.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([method, amount]) => (
                <div key={method} className="flex justify-between gap-4 px-5 py-3">
                  <span className="capitalize text-slate-300">{method.replaceAll("_", " ")}</span>
                  <span className="font-medium">{money(amount, configuredLocale, configuredCurrency)}</span>
                </div>
              ))}
            </div>
          )}
        </section>

        <section className="overflow-hidden rounded-xl border border-slate-800 bg-slate-900">
          <div className="border-b border-slate-800 px-5 py-4">
            <h2 className="font-semibold">Transaction register</h2>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-left text-sm">
              <thead className="bg-slate-950 text-xs uppercase tracking-wide text-slate-500">
                <tr>
                  <th className="px-5 py-3">Reference</th>
                  <th className="px-5 py-3">Student</th>
                  <th className="px-5 py-3">Method</th>
                  <th className="px-5 py-3">Received by</th>
                  <th className="px-5 py-3 text-right">Amount (UGX)</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800">
                {payments.map((payment) => {
                  const account = accountById.get(payment.student_fee_account_id);
                  return (
                    <tr key={payment.id}>
                      <td className="px-5 py-3 break-all">{payment.reference}</td>
                      <td className="px-5 py-3">{studentById.get(account?.student_id ?? "") ?? "Unknown student"}</td>
                      <td className="px-5 py-3 capitalize">{payment.payment_method.replaceAll("_", " ")}</td>
                      <td className="px-5 py-3">{receiverById.get(payment.received_by_user_id) ?? "Unknown staff"}</td>
                      <td className="px-5 py-3 text-right tabular-nums">{Number(payment.amount).toLocaleString("en-UG")}</td>
                    </tr>
                  );
                })}
                {payments.length === 0 ? (
                  <tr><td colSpan={5} className="px-5 py-8 text-center text-slate-400">No confirmed payments for this date.</td></tr>
                ) : null}
              </tbody>
              <tfoot className="bg-slate-950 font-semibold">
                <tr>
                  <td colSpan={4} className="px-5 py-4">Total confirmed collections</td>
                  <td className="px-5 py-4 text-right tabular-nums">{money(total, configuredLocale, configuredCurrency)}</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </section>
      </div>
    </main>
  );
}
